{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yaministudio-web",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "bun run build || npm run build"
  }
}
